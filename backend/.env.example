PORT=3001
NODE_ENV=development

# Database — SQLite for dev, PostgreSQL for prod
DATABASE_URL=./data/thufu_deploy.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/thufu_deploy

# JWT
JWT_SECRET=thufu-deploy-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19000

# Server
HOST=0.0.0.0
